flowchart TD
    S((" ")):::term
    E(("done")):::term
    pull_context[["pull context"]]:::tool
    plan_queries(["plan queries"]):::agent
    search[["search"]]:::tool
    triage(["triage"]):::agent
    deep_read[["deep read"]]:::tool
    annotate[["annotate"]]:::tool
    synthesize(["synthesize"]):::agent
    self_critique(["self critique"]):::agent
    persist[["persist"]]:::tool
