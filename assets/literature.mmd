    pull_context --> plan_queries
    plan_queries --> search
    search --> triage
    triage --> deep_read
    deep_read --> annotate
    annotate --> synthesize
    synthesize --> self_critique
    persist --> E
    self_critique -->|revise| synthesize
    self_critique -->|accept| persist
