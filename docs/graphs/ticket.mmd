flowchart TD
    S((" ")):::term
    E(("done")):::term
    read_ticket[["read ticket"]]:::tool
    gather_context(["gather context"]):::agent
    plan(["plan"]):::agent
    implement(["implement"]):::agent
    run_tests[["run tests"]]:::tool
    debug(["debug"]):::agent
    self_review(["self review"]):::agent
    finalize[["finalize"]]:::tool
    S --> read_ticket
    read_ticket --> gather_context
    gather_context --> plan
    plan --> implement
    implement --> run_tests
    debug --> run_tests
    self_review --> finalize
    finalize --> E
    run_tests -->|review| self_review
    run_tests -->|debug| debug
