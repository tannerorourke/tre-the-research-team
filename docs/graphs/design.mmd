flowchart TD
    S((" ")):::term
    E(("done")):::term
    pull_design_context[["pull design context"]]:::tool
    hypothesize(["hypothesize"]):::agent
    draft_design(["draft design"]):::agent
    feasibility(["feasibility"]):::agent
    approve_design{"approve design"}:::gate
    register[["register"]]:::tool
    S --> pull_design_context
    pull_design_context --> hypothesize
    hypothesize --> draft_design
    draft_design --> feasibility
    approve_design --> register
    register --> E
    feasibility -->|revise| draft_design
    feasibility -->|approve| approve_design
    classDef agent fill:#dbeafe,stroke:#2563eb,color:#1e3a8a
    classDef tool fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef task fill:#f1f5f9,stroke:#64748b,color:#0f172a
    classDef gate fill:#fef3c7,stroke:#d97706,color:#78350f
    classDef sub fill:#ede9fe,stroke:#7c3aed,color:#4c1d95
    classDef term fill:#0f172a,stroke:#0f172a,color:#f8fafc
